---
title: SFTP File Transfer Script
---
flowchart TD
    A([Start]) --> B["Parse Arguments &\nValidate Parameters"]
    B --> C{"Select Upload Mode"}

    C -->|Single File| D["Select File"]
    C -->|Wildcard| E["Select Directory +\nFile Type Extension"]

    D --> PF{"Pre-flight:\nFile Exists?"}
    E --> PF2{"Pre-flight:\nMatching Files?"}

    PF -->|No| X0(["Exit 1 — No File\n(no log / CSV created)"])
    PF -->|Yes| INIT
    PF2 -->|No| X0Q(["Exit 0 — Nothing to Do\n(no log / CSV created)"])
    PF2 -->|Yes| INIT

    INIT["Initialize Logging\n& CSV Output"] --> F["Compress to .gz"]
    F --> H["SFTP Upload to\nMOVEit Gateway"]
    H --> I{Upload\nSuccessful?}
    I -->|No| X2([Failed — Exit])

    I -->|Yes| J{"Post-Upload\nCleanup?"}
    J -->|Keep| K["Retain Source Files"]
    J -->|Delete| L["Delete Source Files"]
    J -->|Move| M["Move to\n/processed"]

    K --> N([Done])
    L --> N
    M --> N

    classDef startEnd fill:#e2e3e5,stroke:#6c757d,color:#000
    classDef action fill:#cce5ff,stroke:#004085,color:#000
    classDef decision fill:#fff3cd,stroke:#856404,color:#000
    classDef fail fill:#f8d7da,stroke:#dc3545,color:#000
    classDef success fill:#d4edda,stroke:#28a745,color:#000
    classDef earlyExit fill:#fce4ec,stroke:#c62828,color:#000

    class A,N startEnd
    class B,D,E,INIT,F,H,K,L,M action
    class C,PF,PF2,I,J decision
    class X0,X0Q earlyExit
    class X2 fail
